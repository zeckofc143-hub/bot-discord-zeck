# Token do bot no Discord Developer Portal
DISCORD_TOKEN=cole_o_token_do_bot_aqui

# Porta do bot + dashboard
PORT=8000

# URL pública SEM barra no final. Ex.: https://meu-bot.discloud.app
DASHBOARD_URL=http://localhost:8000

# OAuth2 do Discord (Developer Portal > OAuth2)
DISCORD_CLIENT_ID=cole_o_application_id_aqui
DISCORD_CLIENT_SECRET=cole_o_client_secret_aqui
# Deve ser exatamente: DASHBOARD_URL + /auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque_por_uma_chave_grande_e_aleatoria

# Somente para visualizar localmente sem OAuth. Não use em produção.
DASHBOARD_DEMO_MODE=false

# Produção: PostgreSQL persistente. A hospedagem preenche esta variável.
DATABASE_URL=
# Use true somente se o provedor exigir SSL na conexão.
DATABASE_SSL=false
# Opcional: carga inicial em base64 usada apenas quando o banco está vazio.
DATABASE_SEED_BASE64=

# Opcional: comandos aparecem instantaneamente somente neste servidor durante testes
TEST_GUILD_ID=
